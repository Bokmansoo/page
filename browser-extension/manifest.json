{
  "manifest_version": 3,
  "name": "Sellform Product Capture",
  "version": "0.2.0",
  "description": "User-triggered, reference-only product material capture for Sellform.",
  "action": { "default_popup": "popup.html", "default_title": "Sellform 상품 수집" },
  "permissions": ["activeTab", "scripting", "storage", "permissions"],
  "host_permissions": ["http://127.0.0.1:8001/*", "http://localhost:8001/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {}
}
