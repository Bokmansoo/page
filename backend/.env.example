# Local OAuth configuration for Sellform
# Copy this file to backend/.env, then fill in the values issued by each provider.
# Never commit backend/.env or its real secrets to GitHub.

SELLFORM_AUTH_MODE=development
# LG-0 keeps the existing sequential generation path. Do not switch this to
# langgraph until LG-1's persistent runtime and graph-run APIs are complete.
SELLFORM_GRAPH_RUNTIME=legacy
# Empty means DATABASE_URL. Must be PostgreSQL when SELLFORM_GRAPH_RUNTIME is
# switched on in a later migration Sprint.
SELLFORM_LANGGRAPH_CHECKPOINT_DATABASE_URL=
SELLFORM_LANGGRAPH_CHECKPOINT_SETUP_ON_START=true
SELLFORM_SESSION_SECRET=replace-with-a-long-random-secret-before-production
SELLFORM_PUBLIC_APP_URL=http://localhost:3000
SELLFORM_PUBLIC_API_URL=http://localhost:8001
SELLFORM_SESSION_COOKIE_SECURE=false

# LG-5R durable image outbox worker. The poller is optional; the same DB lease
# contract can also be run as a dedicated `image_generation_worker` process.
SELLFORM_IMAGE_WORKER_ENABLED=true
SELLFORM_IMAGE_WORKER_POLL_SECONDS=0.5
SELLFORM_IMAGE_WORKER_LEASE_SECONDS=60
SELLFORM_IMAGE_WORKER_BATCH_SIZE=4

SELLFORM_OAUTH_GOOGLE_CLIENT_ID=
SELLFORM_OAUTH_GOOGLE_CLIENT_SECRET=

SELLFORM_OAUTH_KAKAO_CLIENT_ID=
SELLFORM_OAUTH_KAKAO_CLIENT_SECRET=

SELLFORM_OAUTH_NAVER_CLIENT_ID=
SELLFORM_OAUTH_NAVER_CLIENT_SECRET=
